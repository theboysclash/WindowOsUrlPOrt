{
  "name": "VM relay",
  "image": "mcr.microsoft.com/devcontainers/go:1",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "containerEnv": {
    "GOTOOLCHAIN": "auto"
  },
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": {
      "label": "VM relay",
      "onAutoForward": "silent"
    }
  },
  "postStartCommand": "bash .devcontainer/start-relay.sh",
  "waitFor": "postStartCommand",
  "customizations": {
    "codespaces": {
      "openFiles": ["RELAY-LINK.txt"]
    }
  }
}
